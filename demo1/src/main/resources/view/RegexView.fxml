<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="main.java.org.example.controller.RegexController"
      spacing="10"
      style="-fx-background-color: #f5f5f5;">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
       </padding>

    <!-- Header -->
    <Label text="Regular Expression Tool"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333333; -fx-padding: 0 0 10 0;"/>

    <!-- Status Label -->
    <Label fx:id="statusLabel" style="-fx-font-size: 12px; -fx-padding: 0 0 5 0;"/>

    <!-- Pattern Section -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Pattern:"
               style="-fx-font-weight: bold; -fx-min-width: 80; -fx-font-size: 14px;"/>
        <TextField fx:id="regexField"
                   promptText="Enter regular expression"
                   style="-fx-font-family: monospace; -fx-font-size: 14px; -fx-min-width: 300;"
                   HBox.hgrow="ALWAYS"/>
        <Button fx:id="savePatternButton" text="Save"
                onAction="#handleSavePattern"
                style="-fx-background-color: #5c6bc0; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 80;"/>
    </HBox>

    <!-- Options -->
    <HBox spacing="20" style="-fx-padding: 5 0 10 0;">
        <CheckBox fx:id="caseInsensitiveCheck" text="Case Insensitive"
                  style="-fx-font-size: 13px;"/>
        <CheckBox fx:id="multilineCheck" text="Multiline"
                  style="-fx-font-size: 13px;"/>
    </HBox>

    <!-- Input Area -->
    <Label text="Input Text:" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
    <TextArea fx:id="inputTextArea"
              promptText="Enter text to analyze..."
              style="-fx-font-family: monospace; -fx-font-size: 14px; -fx-background-color: white;"
              prefHeight="200"/>

    <!-- Action Buttons -->
    <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10 0 10 0;">
        <Button text="Find Matches"
                onAction="#handleSearch"
                style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 120; -fx-font-size: 14px;"/>

        <Button fx:id="replaceButton" text="Replace All"
                onAction="#handleReplaceAll"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 120; -fx-font-size: 14px;"/>

        <TextField fx:id="replacementField"
                   promptText="Replacement text"
                   style="-fx-font-family: monospace; -fx-font-size: 14px; -fx-min-width: 200;"
                   visible="false"/>
    </HBox>

    <!-- Results Section -->
    <Label text="Results:" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
    <TextArea fx:id="resultTextArea"
              editable="false"
              style="-fx-font-family: monospace; -fx-font-size: 14px; -fx-background-color: #f8f8f8;"
              prefHeight="200"/>
</VBox>
